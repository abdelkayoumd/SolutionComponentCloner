<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SolutionComponentCloner</RootNamespace>
    <AssemblyName>SolutionComponentCloner</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!-- NuGet metadata for the XrmToolBox Tool Library: the "XrmToolBox" tag and the lib/net48/Plugins layout are what it expects. -->
  <PropertyGroup>
    <PackageId>SolutionComponentCloner</PackageId>
    <Version>1.0.0</Version>
    <Authors>abdel</Authors>
    <Description>Copies components from one Dataverse solution into another, with optional required-component inclusion.</Description>
    <PackageTags>XrmToolBox</PackageTags>
    <PackageProjectUrl>https://github.com/abdelkayoumd/SolutionComponentCloner</PackageProjectUrl>
    <RepositoryUrl>https://github.com/abdelkayoumd/SolutionComponentCloner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="lib/net48/Plugins/" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" />
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.9.64" />
  </ItemGroup>

  <!--
    Deploys the built plugin straight into the local XrmToolBox install after every build,
    so relaunching XrmToolBox (or hitting F5 with the debug launch settings in
    SolutionComponentCloner.csproj.user) always picks up the latest code.
  -->
  <Target Name="DeployToXrmToolBox" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' AND '$(APPDATA)' != ''">
    <PropertyGroup>
      <XrmToolBoxPluginsDir>$(APPDATA)\MscrmTools\XrmToolBox\Plugins\</XrmToolBoxPluginsDir>
    </PropertyGroup>
    <ItemGroup>
      <XrmToolBoxDeployFiles Include="$(TargetDir)$(TargetName).dll" />
      <XrmToolBoxDeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(XrmToolBoxPluginsDir)" Condition="!Exists('$(XrmToolBoxPluginsDir)')" />
    <!--
      Retries="1" plus ContinueOnError so that having XrmToolBox open (which locks the DLL)
      turns into a warning telling you to restart it, instead of failing the whole build.
    -->
    <Copy SourceFiles="@(XrmToolBoxDeployFiles)" DestinationFolder="$(XrmToolBoxPluginsDir)" SkipUnchangedFiles="false"
          Retries="1" RetryDelayMilliseconds="300" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>

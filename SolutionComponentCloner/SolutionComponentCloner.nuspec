<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SolutionComponentCloner</id>
    <version>$version$</version>
    <title>Solution Component Cloner</title>
    <authors>abdelkayoumd</authors>
    <license type="expression">MIT</license>
    <description>Copies components from one Dataverse / Dynamics 365 solution into another, with optional required-component inclusion. Pick a source and an unmanaged target solution, select components, and copy them in one click.</description>
    <releaseNotes>1.0.2: A search box, sortable Modified columns, markers for components already in the target, a required-components preview, a per-table subcomponent choice, batched copy with progress and Cancel, Publish all, New solution, a yellow note on tables added completely with a confirmation before copying them or model-driven apps, corrected component type numbers, canvas apps and flows grouped by kind, solutions listed newest first, and faster loading. 1.0.1: Author name updated. 1.0.0: First release. Copy components between solutions (with or without required components), paged solution and component loading, readable names for custom component types, and export of failed copies to CSV.</releaseNotes>
    <tags>XrmToolBox</tags>
    <projectUrl>https://github.com/abdelkayoumd/SolutionComponentCloner</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/abdelkayoumd/SolutionComponentCloner/main/assets/icon.png</iconUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <repository type="git" url="https://github.com/abdelkayoumd/SolutionComponentCloner" />
    <dependencies>
      <dependency id="XrmToolBox" version="1.2025.10.74" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\SolutionComponentCloner.dll" target="lib\net48\Plugins\" />
    <file src="..\assets\icon.png" target="" />
    <file src="..\README.md" target="" />
  </files>
</package>
